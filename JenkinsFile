
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                bat 'python --version'
                bat 'pip --version'
            }
        }

        stage('Run Application') {
            steps {
                bat 'python app.py'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'python -m pytest'
            }
        }

        stage('Build') {
            steps {
                echo 'Build Successful'
            }
        }
    }

    post {
        success {
            echo 'Jenkins Build Successful'
        }
        failure {
            echo 'Jenkins Build Failed'
        }
    }
}
